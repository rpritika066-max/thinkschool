{
  "ConnectionStrings": {
    "Quotes": "Data Source=quotes.db"
  },

  "Jwt": {
    "Issuer": "QuotesApi",
    "Audience": "QuotesApi",
    "AccessTokenLifetime": "01:00:00"
  },

  "EntraId": {
    "TenantId": "",
    "ClientId": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Debug",
        "QuotesApi": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] TraceId={TraceId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
